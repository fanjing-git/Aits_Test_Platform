# Django runtime settings. Copy this file to .env only after assigning
# environment-specific values. Never commit the resulting .env file.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,server.example.com
MODEL_CONFIG_FERNET_KEY=

# The only browser address administrators should share with colleagues.
# Production must set this explicitly; the local dev settings default to 127.0.0.1:5173.
PUBLIC_APP_URL=http://127.0.0.1:5173
# Optional only for a separately deployed, non-same-origin API.
PUBLIC_API_URL=

# First deployment only. The command creates this account once and never resets it.
# Keep the real password in the deployment secret store or uncommitted .env.remote.
AITS_BOOTSTRAP_ADMIN_USERNAME=platform_admin
AITS_BOOTSTRAP_ADMIN_PASSWORD=

# Database, Redis and Celery values are activated in T002.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Comma-separated trusted origins (scheme, host and port) for health probes.
ENVIRONMENT_HEALTH_ALLOWED_ORIGINS=http://127.0.0.1:8000

# Local knowledge document limits and chunking.
KNOWLEDGE_DOCUMENT_ROOT=.runtime/knowledge-documents
KNOWLEDGE_DOCUMENT_MAX_BYTES=10485760
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# Requirement document upload limits.
REQUIREMENT_DOCUMENT_ROOT=.runtime/requirement-documents
REQUIREMENT_DOCUMENT_MAX_BYTES=10485760
